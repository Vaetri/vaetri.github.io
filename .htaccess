# Сайт можно встраивать в iframe (например, в конструктор или предпросмотр).
Content-Security-Policy: frame-ancestors *;

# Гостям всегда отдаём готовую страницу: index.html — главная.
DirectoryIndex index.html

# Кеширование статики: файлы стилей и скриптов меняются только при публикации.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
